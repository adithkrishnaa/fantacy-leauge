<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks plain HTTP by default. The app currently targets the local
  Express backend over http://, so cleartext is permitted for the hosts used in
  development.

  10.0.2.2   - the Android emulator's alias for the host machine's localhost
  localhost  - a device with `adb reverse tcp:5001 tcp:5001`
  127.0.0.1  - same, via the loopback address

  Testing from a physical phone over Wi-Fi? Add that machine's LAN address as
  another <domain> entry, e.g. <domain includeSubdomains="false">192.168.1.5</domain>

  BEFORE SHIPPING TO PRODUCTION: point the app at the HTTPS API and delete this
  file along with the android:networkSecurityConfig attribute in
  AndroidManifest.xml, so the app refuses cleartext entirely.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
