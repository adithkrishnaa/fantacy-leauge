# Copy this file to .env and fill in real values. Do NOT commit .env.

# --- Database (Postgres) ---
DATABASE_URL=postgresql://user:password@localhost:5432/fantasyleague

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret

# --- Server ---
PORT=5001
NODE_ENV=development

# --- CORS ---
# Optional. Comma-separated extra browser origins allowed to call the API,
# in addition to the built-in production/localhost defaults.
# CORS_ORIGINS=https://staging.example.com,http://localhost:5173

# --- WhatsApp / Redis ---
# WhatsApp notifications are currently disabled (services/queueService.js is a
# no-op shim), so no Redis or WhatsApp API credentials are required. If you
# re-enable notifications, restore the Bull/Redis queue and add REDIS_* and
# WHATSAPP_* variables back here.
